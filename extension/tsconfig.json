  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "jsx": "preserve",
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "popup.html", "manifest.config.ts"]
}
