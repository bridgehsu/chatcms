{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chatcms",
  "version": "0.0.4",
  "identifier": "com.xukui.chatcms",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:15420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChatCMS",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
